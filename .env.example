# Copy to `.env` for local development. Leave blank to run fully offline
# (annotations persist in localStorage only).

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=

# Publishable key only (Settings → API) — never the secret / service_role key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Auth: anonymous sessions created on first annotation save (not on page load).
# In Supabase Dashboard: Authentication → Providers → Anonymous: ON
# Client: supabase.auth.signInAnonymously() inside ensureAuthSession() on capture.
# Optional Turnstile browse gate (site key public). Secret stays in Supabase Auth settings.
# Add localhost + your Pages host to the Cloudflare domain allowlist.
TURNSTILE_SITEKEY=
# VITE_TURNSTILE_SITEKEY=

# Legacy alias still accepted if PUBLISHABLE is unset:
# VITE_SUPABASE_ANON_KEY=

# Bug report button — GitHub Issues “new issue” URL (public).
# CI sets this from github.repository automatically.
# VITE_BUG_REPORT_URL=https://github.com/OWNER/REPO/issues/new?template=bug_report.md&title=%5BBug%5D%20

# Private contact email for mailto: (GitHub Actions secret name: EMAIL)
EMAIL=

# Static asset/router base. CI sets this for GitHub Pages project sites.
# BASE_PATH=/
